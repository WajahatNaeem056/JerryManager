# Lineage Identity Cleanup: prop overrides applied by features/lineage_identity_cleanup.sh
# Format: key=value, one per line. Lines starting with # are ignored.
#
# Values are set to empty: this removes the LineageOS-specific identity signal without
# inventing a fake vendor fingerprint. Props handled elsewhere (ro.crypto.state, ro.build.tags,
# ro.build.type, ro.build.display.id, ro.build.description, ro.build.version.incremental,
# ro.modversion) are deliberately not repeated here, so two scripts never fight over one prop.
# Some ROMs use other prefixes (e.g. ro.crdroid.*, ro.pixelexperience.*) that are not listed.

ro.lineage.version=
ro.lineage.device=
ro.lineage.build.version=
ro.lineage.build.version.plat.sdk=
ro.lineage.releasetype=
