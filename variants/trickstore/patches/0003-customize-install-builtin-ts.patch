--- a/Jerry/customize.sh
+++ b/Jerry/customize.sh
@@ -16,6 +16,46 @@
 resolve_keystore_backend
 ui_print "- Keystore backend: $KEYSTORE_NAME"
 
+# --- Built-in Tricky Store OSS: pick the binaries for this device ---
+_jm_install_ts() {
+  case "$ARCH" in
+    arm64) _ts_abi="arm64-v8a" ;;
+    arm)   _ts_abi="armeabi-v7a" ;;
+    x64)   _ts_abi="x86_64" ;;
+    x86)   _ts_abi="x86" ;;
+    *)     abort "! Unsupported architecture: $ARCH" ;;
+  esac
+  if [ "$API" -lt 29 ]; then
+    abort "! Unsupported SDK: $API. Tricky Store OSS needs Android 10 or newer"
+  fi
+  if [ "$KSU" = true ] && [ "$KSU_VER_CODE" -lt 10670 ]; then
+    abort "! Please update your KernelSU and KernelSU Manager"
+  fi
+
+  ui_print "- Built-in Tricky Store OSS ($ARCH, SDK $API)"
+  if [ ! -f "$MODPATH/ts/lib/$_ts_abi/libTrickyStoreOSS.so" ] || [ ! -f "$MODPATH/ts/lib/$_ts_abi/libinject.so" ]; then
+    abort "! Tricky Store OSS files for $_ts_abi are missing from this zip"
+  fi
+  mv "$MODPATH/ts/lib/$_ts_abi/libTrickyStoreOSS.so" "$MODPATH/ts/libTrickyStoreOSS.so"
+  mv "$MODPATH/ts/lib/$_ts_abi/libinject.so" "$MODPATH/ts/inject"
+  rm -rf "$MODPATH/ts/lib"
+  chmod 755 "$MODPATH/ts/daemon" "$MODPATH/ts/inject" "$MODPATH/ts/supervisor.sh"
+
+  # Another keystore module would hook keystore2 next to the built-in one. It is only disabled
+  # (takes effect after reboot), never removed: deleting its "disable" file re-enables it.
+  for _ts_old in $TS_CONFLICT_IDS; do
+    if [ -d "/data/adb/modules/$_ts_old" ]; then
+      touch "/data/adb/modules/$_ts_old/disable" 2>/dev/null
+      ui_print "! Standalone $_ts_old found: disabled, not removed (takes effect after reboot)"
+    fi
+  done
+
+  ensure_dir "$TRICKY_DIR"
+  [ -f "$TARGET_TXT" ] || touch "$TARGET_TXT"
+  unset _ts_abi _ts_old
+}
+_jm_install_ts
+
 # Ask whether to install the built-in PIF: Vol+ = yes, Vol- = no.
 # Default is yes: no key within 5 seconds, or no getevent/timeout, installs it.
 _jm_ask_pif() {
